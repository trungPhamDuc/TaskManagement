@page
@model TaskManagement.Pages.AccountsModel
@using TaskManagement.Models
@{ ViewData["Title"] = "Quản lý tài khoản"; }
<main class="accounts-page"><header><div><div class="eyebrow">TPM · ADMIN</div><h1>Quản lý tài khoản</h1><p>Tạo và quản lý tài khoản cho nhân viên, supervisor.</p></div><nav><a asp-page="/Index">Bảng công việc</a><a asp-page="/Logout">Đăng xuất</a></nav></header>
<div class="accounts-grid"><section class="account-panel"><h2>Tạo tài khoản</h2><form method="post" asp-page-handler="Create"><label>Họ và tên<input name="FullName" required maxlength="120"></label><label>Username<input name="Username" required maxlength="100"></label><label>Mật khẩu khởi tạo<input name="Password" type="password" required minlength="6"></label><label>Vai trò<select name="Role"><option value="Employee">Nhân viên</option><option value="Supervisor">Supervisor</option><option value="Leader">Leader</option><option value="Admin">Admin</option></select></label><label>Nhóm/ca<select id="account-group" name="Group"><option value="ShiftA">Shift A</option><option value="ShiftB">Shift B</option><option value="Administration">Hành chính</option></select></label><label id="account-area">Khu vực<select name="Area"><option value="Mount">Mount</option><option value="AOI">AOI</option><option value="ReflowOven">Reflow Oven</option><option value="Other">Other</option><option value="Office">Văn phòng</option></select></label><button class="primary-button">Tạo tài khoản</button></form></section>
<section class="account-panel"><h2>Tài khoản hiện có</h2><div class="account-table"><table><thead><tr><th>Người dùng</th><th>Username</th><th>Vai trò</th><th>Nhóm</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var u in Model.Users){<tr><td>@u.FullName</td><td>@u.Username</td><td>@u.Role.Label()</td><td>@u.Group.Label()</td><td>@(u.IsActive ? "Đang hoạt động" : "Đã khóa")</td><td class="account-actions"><form method="post" asp-page-handler="Toggle"><input type="hidden" name="id" value="@u.Id"><button class="table-action">@(u.IsActive ? "Khóa" : "Mở khóa")</button></form><form method="post" asp-page-handler="Delete" onsubmit="return confirm('Xóa vĩnh viễn tài khoản @u.Username?')"><input type="hidden" name="id" value="@u.Id"><button class="table-action danger">Xóa</button></form></td></tr>}</tbody></table></div></section></div></main>
<script>const groupSelect=document.getElementById('account-group');const areaField=document.getElementById('account-area');function updateAreaVisibility(){areaField.hidden=groupSelect.value==='Administration'}groupSelect.addEventListener('change',updateAreaVisibility);updateAreaVisibility();</script>
